# Copy to outreach/.env (git-ignored) and fill in. Never commit the real file.

# --- Who the email is from -------------------------------------------------
SENDER_NAME=Rayyan
SENDER_TITLE=Business Development
SENDER_COMPANY=Lonestar Shipping Co. Ltd, Dammam
SENDER_ADDRESS=Al Waha Downtown Mall, Prince Mohammed Bin Fahad Road, Dammam, Saudi Arabia
SENDER_PHONE=+966 53 502 2995
SENDER_EMAIL=rayyan@lonestarshipping.com
SENDER_WEBSITE=www.lonestarshipping.com
# SENDER_REPLY_TO=sales@lonestarshipping.com

# --- Option A: Microsoft 365 via Microsoft Graph (lonestarshipping.com is on M365) ---
# Azure portal > Microsoft Entra ID > App registrations > New registration.
# API permissions > Microsoft Graph > Application permissions: Mail.Send, Mail.Read > Grant admin consent.
# Certificates & secrets > New client secret.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Option B: plain SMTP (leave the GRAPH_ lines empty to use this) ---------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=rayyan@lonestarshipping.com
# SMTP_PASSWORD=

# --- Pace ------------------------------------------------------------------
# Start at 20-30 a day for the first two weeks, then raise it slowly.
DAILY_LIMIT=30
DELAY_SECONDS=60-150
# Sun-Thu (Python weekday numbers: Sun=6, Mon=0 ... Thu=3), 08:00-16:00 Saudi time
SEND_DAYS=6,0,1,2,3
SEND_HOURS=8-16
